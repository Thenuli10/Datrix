{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd /d backend && .venv\\Scripts\\python -m uvicorn app.main:app --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "backend-demo",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd /d Datrix\\backend && set LLM_FAKE=true&& set SANDBOX_BACKEND=local&& set STORAGE_DIR=..\\storage\\demo&& .venv\\Scripts\\python -m uvicorn app.main:app --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3000
    }
  ]
}