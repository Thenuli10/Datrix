# Copy to backend/.env
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1
OPENAI_SMALL_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1

# docker (default, isolated) | local (subprocess, NO isolation, dev only)
SANDBOX_BACKEND=docker
SCREENSHOTS_ENABLED=true
FRONTEND_URL=http://localhost:3000

# --- OpenAI spend safety net (estimated from llm_calls; checked before EVERY request) ---
# When a cap is hit the request is not sent: runs end FAILED, request-time steps return 402.
LLM_MAX_COST_PER_RUN_USD=0.50
LLM_MAX_COST_PER_PROJECT_USD=2.00
LLM_DAILY_BUDGET_USD=3.00          # all projects, per UTC day
LLM_MAX_CALLS_PER_PROJECT=150
LLM_MAX_OUTPUT_TOKENS=8000         # per code-generation call
LLM_MAX_OUTPUT_TOKENS_OTHER=4000   # per call, every other agent
LLM_MAX_INPUT_CHARS=200000         # prompt text per call (~50k tokens); larger prompts are refused
LLM_TOOL_MAX_STEPS=8               # validator tool rounds (+1 final answer)
LLM_TOOL_MAX_CALLS_PER_STEP=8
LLM_TOOL_OUTPUT_CHARS=8000         # per tool result
LLM_TOOL_TOTAL_OUTPUT_CHARS=60000  # per validator loop
LLM_MAX_IMAGES=4                   # screenshots per vision call
LLM_VISION_DETAIL=high             # low | high | auto

# --- Agent loops ---
MAX_FIX_ATTEMPTS=4                 # coder calls per fix loop
MAX_SANITY_ROUNDS=2                # sanity-fix rounds after the first generation
MAX_DASHBOARD_QA_ROUNDS=2          # composer fix rounds (+1 final QA review)
